#!/usr/bin/env bash
set -euo pipefail

# Modified from Headlong at 24e7ce77404357aef7b3fc87567e7be908258853.
file="${1:?Usage: view FILE [START[:END]]}"
range="${2:-1:}"
[[ -f "$file" && -r "$file" ]] || { printf 'view: cannot read %s\n' "$file" >&2; exit 66; }
start="${range%%:*}"
end="${range#*:}"
[[ "$range" == *:* ]] || end=""
[[ "$start" =~ ^[1-9][0-9]*$ && ( -z "$end" || "$end" =~ ^[1-9][0-9]*$ ) ]] || {
    printf 'view: invalid range\n' >&2; exit 64;
}
awk -v start="$start" -v end="$end" 'NR >= start && (end == "" || NR <= end) {printf "%6d\t%s\n", NR, $0}' "$file"
