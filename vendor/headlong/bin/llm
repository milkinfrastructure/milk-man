#!/usr/bin/env bash
set -euo pipefail

# Modified from Headlong at 24e7ce77404357aef7b3fc87567e7be908258853.
# Milk retains only the generic OpenAI-compatible, non-streaming call.

die() { printf 'llm: %s\n' "$*" >&2; exit 70; }

system_file=""
messages_file=""
tools_file=""
json_response=0
while (( $# )); do
    case "$1" in
        --system-file) system_file="${2:?--system-file requires a path}"; shift 2 ;;
        --messages-file) messages_file="${2:?--messages-file requires a path}"; shift 2 ;;
        --tools-file) tools_file="${2:?--tools-file requires a path}"; shift 2 ;;
        --json-response) json_response=1; shift ;;
        -h|--help)
            printf '%s\n' 'Usage: llm --system-file FILE --messages-file FILE [--tools-file FILE --json-response]'
            exit 0
            ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ -r "$system_file" ]] || die "cannot read system prompt: $system_file"
[[ -r "$messages_file" ]] || die "cannot read messages: $messages_file"
[[ -z "$tools_file" || -r "$tools_file" ]] || die "cannot read tools: $tools_file"
: "${LLM_API_URL:?LLM_API_URL is required}"
: "${LLM_MODEL:?LLM_MODEL is required}"
command -v curl >/dev/null || die "curl is required"
command -v python3 >/dev/null || die "python3 is required"

tmp="$(mktemp -d "${TMPDIR:-/tmp}/milk-llm.XXXXXX")"
chmod 700 "$tmp"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT INT TERM

payload="$tmp/payload.json"
response="$tmp/response.json"
headers="$tmp/headers"
auth="$tmp/auth"

LLM_SYSTEM_FILE="$system_file" LLM_MESSAGES_FILE="$messages_file" \
LLM_TOOLS_FILE="$tools_file" LLM_PAYLOAD_FILE="$payload" python3 - <<'PY'
import json
import os

with open(os.environ["LLM_MESSAGES_FILE"]) as handle:
    messages = json.load(handle)
if not isinstance(messages, list):
    raise SystemExit("llm: messages must be a JSON array")
with open(os.environ["LLM_SYSTEM_FILE"]) as handle:
    system = handle.read()
model = os.environ["LLM_MODEL"]
mode = os.environ.get("LLM_API_MODE", "chat_completions")
if mode not in {"chat_completions", "responses"}:
    raise SystemExit("llm: LLM_API_MODE is invalid")
if mode == "responses":
    items = []
    for message in messages:
        role = message.get("role")
        content = message.get("content")
        if role in {"user", "assistant"} and isinstance(content, str) and content:
            items.append({"role": role, "content": content})
        if role == "assistant":
            for call in message.get("tool_calls", []):
                function = call["function"]
                items.append({"type": "function_call", "call_id": call["id"], "name": function["name"], "arguments": function["arguments"]})
        elif role == "tool":
            items.append({"type": "function_call_output", "call_id": message["tool_call_id"], "output": content})
    payload = {"model": model, "instructions": system, "input": items}
else:
    payload = {"model": model, "messages": [{"role": "system", "content": system}, *messages]}
effort = os.environ.get("LLM_REASONING_EFFORT", "")
if effort:
    if effort not in {"none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"}:
        raise SystemExit("llm: LLM_REASONING_EFFORT is invalid")
    payload["reasoning" if mode == "responses" else "reasoning_effort"] = {"effort": effort} if mode == "responses" else effort
tools_file = os.environ.get("LLM_TOOLS_FILE")
if tools_file:
    with open(tools_file) as handle:
        tools = json.load(handle)
    if not isinstance(tools, list) or not tools:
        raise SystemExit("llm: tools must be a non-empty JSON array")
    payload["tools"] = ([{"type": "function", **tool["function"]} for tool in tools] if mode == "responses" else tools)
    payload["tool_choice"] = "required"
    payload["parallel_tool_calls"] = False
    if mode == "chat_completions":
        payload["temperature"] = 0
maximum = int(os.environ.get("LLM_MAX_TOKENS", "16384"))
payload["max_output_tokens" if mode == "responses" else ("max_completion_tokens" if model.startswith(("gpt-5", "o1", "o3", "o4")) else "max_tokens")] = maximum
with open(os.environ["LLM_PAYLOAD_FILE"], "w") as handle:
    json.dump(payload, handle, ensure_ascii=False, separators=(",", ":"))
PY

curl_args=(
    --disable
    --silent --show-error
    --connect-timeout "${LLM_CONNECT_TIMEOUT:-10}"
    --max-time "${LLM_MAX_TIME:-900}"
    --max-filesize 4194304
    --header 'Content-Type: application/json'
    --data-binary "@$payload"
    --dump-header "$headers"
    --output "$response"
    --write-out '%{http_code}'
)

if [[ -n "${LLM_API_KEY:-}" ]]; then
    [[ "$LLM_API_KEY" != *$'\n'* && "$LLM_API_KEY" != *$'\r'* ]] || die "LLM_API_KEY contains a newline"
    escaped="${LLM_API_KEY//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    printf 'header = "Authorization: Bearer %s"\n' "$escaped" > "$auth"
    chmod 600 "$auth"
    curl_args+=(--config "$auth")
fi

http_code="$(curl "${curl_args[@]}" "$LLM_API_URL")" || die "request failed"
(( $(wc -c < "$response") <= 4194304 )) || die "response exceeded 4 MiB"
if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
    detail="$(python3 - "$response" <<'PY'
import json, sys
try:
    value = json.load(open(sys.argv[1]))
    print(str(value.get("error", value))[:1000])
except Exception:
    print(open(sys.argv[1], errors="replace").read(1000))
PY
)"
    die "HTTP $http_code: $detail"
fi

python3 - "$response" "$headers" "$json_response" <<'PY'
import json
import os
import sys

value = json.load(open(sys.argv[1]))
if os.environ.get("LLM_API_MODE", "chat_completions") == "responses":
    tool_calls, texts = [], []
    for item in value.get("output", []):
        if item.get("type") == "function_call":
            tool_calls.append({"id": item["call_id"], "type": "function", "function": {"name": item["name"], "arguments": item["arguments"]}})
        elif item.get("type") == "message":
            texts.extend(part.get("text", "") for part in item.get("content", []) if part.get("type") == "output_text")
    message = {"role": "assistant", "content": "".join(texts) or None}
    if tool_calls:
        message["tool_calls"] = tool_calls
else:
    try:
        message = value["choices"][0]["message"]
    except (KeyError, IndexError, TypeError) as error:
        raise SystemExit(f"llm: invalid OpenAI-compatible response: {error}")
if sys.argv[3] == "1":
    if not isinstance(message, dict) or message.get("role") != "assistant":
        raise SystemExit("llm: response contained no assistant message")
    request_id = None
    for line in open(sys.argv[2], errors="replace"):
        name, separator, header_value = line.partition(":")
        if separator and name.lower() == "x-request-id":
            request_id = header_value.strip()
    print(json.dumps({
        "message": message,
        "provider_request_id": request_id,
        "usage": value.get("usage", {}),
    }, ensure_ascii=False, separators=(",", ":")))
    raise SystemExit(0)
content = message.get("content") if isinstance(message, dict) else None
if isinstance(content, list):
    content = "".join(
        part.get("text", "") for part in content if isinstance(part, dict) and part.get("type") in (None, "text", "output_text")
    )
if not isinstance(content, str) or not content:
    finish_reason = None
    if isinstance(value.get("choices"), list) and value["choices"] and isinstance(value["choices"][0], dict):
        finish_reason = value["choices"][0].get("finish_reason")
    reasoning = message.get("reasoning_content") if isinstance(message, dict) else None
    usage = value.get("usage") if isinstance(value.get("usage"), dict) else {}
    tool_calls = message.get("tool_calls") if isinstance(message, dict) else None
    raise SystemExit(
        "llm: response contained no assistant text "
        f"(finish_reason={finish_reason!r}, reasoning_chars={len(reasoning) if isinstance(reasoning, str) else 0}, "
        f"completion_tokens={usage.get('completion_tokens')!r}, "
        f"tool_calls={len(tool_calls) if isinstance(tool_calls, list) else 0})"
    )
print(content)
PY
