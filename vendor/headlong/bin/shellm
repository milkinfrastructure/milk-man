#!/usr/bin/env bash
set -euo pipefail

# Modified from Headlong at 24e7ce77404357aef7b3fc87567e7be908258853.
# Milk retains the local Bash execution loop and append-only conversation.

die() { printf 'shellm: %s\n' "$*" >&2; exit 70; }

system_file=""
prompt_file=""
trajectory=""
workdir=""
while (( $# )); do
    case "$1" in
        --system-file) system_file="${2:?--system-file requires a path}"; shift 2 ;;
        --prompt-file) prompt_file="${2:?--prompt-file requires a path}"; shift 2 ;;
        --trajectory) trajectory="${2:?--trajectory requires a path}"; shift 2 ;;
        --workdir) workdir="${2:?--workdir requires a path}"; shift 2 ;;
        -h|--help)
            printf '%s\n' 'Usage: shellm --system-file FILE --prompt-file FILE --trajectory FILE --workdir DIR'
            exit 0
            ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ -r "$system_file" && -r "$prompt_file" && -f "$trajectory" && -d "$workdir" ]] || die "invalid run paths"
: "${MILK_MAN_STATE_PY:?MILK_MAN_STATE_PY is required}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)"
llm="$root/vendor/headlong/bin/llm"
context="$root/vendor/headlong/bin/context"
maximum="${MILK_MAN_MAX_ITERATIONS:-20}"
[[ "$maximum" =~ ^[1-9][0-9]*$ ]] || die "MILK_MAN_MAX_ITERATIONS must be a positive integer"

append() {
    python3 "$MILK_MAN_STATE_PY" append --trajectory "$trajectory" "$@"
}

append --type prompt --content-file "$prompt_file"
run_dir="$(mktemp -d "${TMPDIR:-/tmp}/milk-shellm.XXXXXX")"
chmod 700 "$run_dir"
cleanup() { rm -rf "$run_dir"; }
trap cleanup EXIT INT TERM

previous_failed_code=""
repeat_failures=0
have_previous_failure=0
note_failure() {
    local current_code
    current_code="$(cat "$code")"
    if (( have_previous_failure )) && [[ "$current_code" == "$previous_failed_code" ]]; then
        repeat_failures=$((repeat_failures + 1))
    else
        repeat_failures=1
    fi
    previous_failed_code="$current_code"
    have_previous_failure=1
    (( repeat_failures < 3 )) || die "the model repeated the same failing Bash block three times"
}
for ((iteration=1; iteration<=maximum; iteration++)); do
    messages="$run_dir/messages.json"
    "$context" > "$messages"
    response="$run_dir/response"
    printf 'milk-man: reasoning %d/%d with %s\n' "$iteration" "$maximum" "$LLM_MODEL" >&2
    "$llm" --system-file "$system_file" --messages-file "$messages" > "$response"

    code="$run_dir/code"
    python3 - "$response" "$code" <<'PY'
import re
import sys

text = open(sys.argv[1]).read()
match = re.search(r"(?ms)```(?:bash|sh|shell)[ \t]*\r?\n(.*?)(?:```|\Z)", text)
code = match.group(1) if match else ""
open(sys.argv[2], "w").write(code)
PY
    append --type reasoning --content-file "$response"

    if [[ ! -s "$code" ]]; then
        output="$run_dir/output"
        printf '%s\n' 'milk-man protocol error: response must include a fenced Bash block' > "$output"
        cat "$output" >&2
        append --type shell-output --content-file "$output" --command-file "$code" --exit-code 65
        note_failure
        continue
    fi

    printf 'milk-man: executing Bash in %s\n' "$workdir" >&2
    sed 's/^/  /' "$code" >&2
    output="$run_dir/output"
    final="$run_dir/final"
    runner="$run_dir/run"
    rm -f "$final"
    {
        printf '%s\n' 'set -euo pipefail'
        printf '%s\n' '__milk_capture_final() {'
        printf '%s\n' '    __milk_rc=$?'
        printf '%s\n' '    trap - EXIT'
        printf '%s\n' '    set +e'
        printf '    if [[ ${FINAL+x} ]]; then printf %%s "$FINAL" > %q; fi\n' "$final"
        printf '    if [[ ${FINAL_FILE+x} ]]; then cat "$FINAL_FILE" > %q; fi\n' "$final"
        printf '%s\n' '    exit "$__milk_rc"'
        printf '%s\n' '}'
        printf '%s\n' 'trap __milk_capture_final EXIT'
        printf 'source %q\n' "$code"
        printf '%s\n' '__milk_rc=$?'
        printf '%s\n' 'trap - EXIT'
        printf 'if [[ ${FINAL+x} ]]; then printf %%s "$FINAL" > %q; fi\n' "$final"
        printf 'if [[ ${FINAL_FILE+x} ]]; then cat "$FINAL_FILE" > %q; fi\n' "$final"
        printf '%s\n' 'exit "$__milk_rc"'
    } > "$runner"

    set +e
    (cd "$workdir" && bash "$runner") 2>&1 | tee "$output" >&2
    pipeline_status=("${PIPESTATUS[@]}")
    exit_code="${pipeline_status[0]}"
    set -e
    (( pipeline_status[1] == 0 )) || die "could not capture command output"
    final_ok=0
    protocol_failed=0
    if [[ -f "$final" ]]; then
        final_content="$(<"$final")"
        final_content="${final_content#"${final_content%%[![:space:]]*}"}"
        final_content="${final_content%"${final_content##*[![:space:]]}"}"
        if (( exit_code == 0 )); then
            case "$final_content" in
                ""|0|1|true|false) ;;
                *) final_ok=1 ;;
            esac
        fi
        if (( ! final_ok )); then
            protocol_failed=1
            printf '\n%s\n' \
                'milk-man protocol error: FINAL or FINAL_FILE requires exit zero and nonblank text other than 0, 1, true, or false' \
                | tee -a "$output" >&2
        fi
    fi

    recorded_exit="$exit_code"
    (( ! protocol_failed || recorded_exit != 0 )) || recorded_exit=65
    append --type shell-output --content-file "$output" --command-file "$code" --exit-code "$recorded_exit"

    if (( final_ok )); then
        append --type final --content-file "$final"
        cat "$final"
        exit 0
    fi

    if (( recorded_exit != 0 )); then
        note_failure
    else
        repeat_failures=0
        have_previous_failure=0
    fi
done

die "maximum iterations reached; resume the trajectory after inspection"
