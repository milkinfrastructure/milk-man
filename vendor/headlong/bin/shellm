#!/usr/bin/env bash
set -euo pipefail

# Modified from Headlong at 24e7ce77404357aef7b3fc87567e7be908258853.
# Milk retains the local Bash execution loop and append-only conversation.

die() { printf 'shellm: %s\n' "$*" >&2; exit 70; }

system_file=""
prompt_file=""
trajectory=""
workdir=""
while (( $# )); do
    case "$1" in
        --system-file) system_file="${2:?--system-file requires a path}"; shift 2 ;;
        --prompt-file) prompt_file="${2:?--prompt-file requires a path}"; shift 2 ;;
        --trajectory) trajectory="${2:?--trajectory requires a path}"; shift 2 ;;
        --workdir) workdir="${2:?--workdir requires a path}"; shift 2 ;;
        -h|--help)
            printf '%s\n' 'Usage: shellm --system-file FILE --prompt-file FILE --trajectory FILE --workdir DIR'
            exit 0
            ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ -r "$system_file" && -r "$prompt_file" && -f "$trajectory" && -d "$workdir" ]] || die "invalid run paths"
: "${MILK_MAN_STATE_PY:?MILK_MAN_STATE_PY is required}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)"
llm="$root/vendor/headlong/bin/llm"
context="$root/vendor/headlong/bin/context"
maximum="${MILK_MAN_MAX_ITERATIONS:-20}"
[[ "$maximum" =~ ^[1-9][0-9]*$ ]] || die "MILK_MAN_MAX_ITERATIONS must be a positive integer"

append() {
    python3 "$MILK_MAN_STATE_PY" append --trajectory "$trajectory" "$@"
}

redact() {
    python3 -u "$MILK_MAN_STATE_PY" redact
}

yield_to_pending() {
    [[ -n "${MILK_MAN_HEARTBEAT_FILE:-}" ]] || return 0
    if python3 - "$MILK_MAN_HEARTBEAT_FILE" <<'PY'
from pathlib import Path
import sys
from milk_v2.heartbeat import read
raise SystemExit(0 if read(Path(sys.argv[1])).get("pending") else 1)
PY
    then
        printf '%s\n' 'milk-man: yielding to the pending operator instruction' >&2
        exit 0
    fi
}

append --type prompt --content-file "$prompt_file"
run_dir="$(mktemp -d "${TMPDIR:-/tmp}/milk-shellm.XXXXXX")"
chmod 700 "$run_dir"
cleanup() { rm -rf "$run_dir"; }
trap cleanup EXIT INT TERM
native_tools="${MILK_MAN_TOOL_CALLS:-1}"
[[ "$native_tools" == 0 || "$native_tools" == 1 ]] || die "MILK_MAN_TOOL_CALLS must be 0 or 1"
python3 - "$run_dir/tools.json" <<'PY'
import json, sys
tools = [
    {"type": "function", "function": {
        "name": "bash", "description": "Execute the next useful Bash commands with inherited environment variables. Each call starts a fresh shell; save reusable settings in a private environment profile and source it in every call. Never sleep or poll. For asynchronous work, launch once, register `man heartbeat wait -- READ_ONLY_STATUS_COMMAND`, and return; the harness yields until that check changes.",
        "parameters": {"type": "object", "properties": {"code": {"type": "string"}}, "required": ["code"], "additionalProperties": False},
    }},
    {"type": "function", "function": {
        "name": "finish", "description": "Finish the task with a factual report only when the objective is complete or a specific external blocker needs human action.",
        "parameters": {"type": "object", "properties": {"report": {"type": "string", "minLength": 1}}, "required": ["report"], "additionalProperties": False},
    }},
]
with open(sys.argv[1], "w") as handle:
    json.dump(tools, handle)
PY

previous_failed_code=""
repeat_failures=0
have_previous_failure=0
note_failure() {
    local current_code
    current_code="$(cat "$code")"
    if (( have_previous_failure )) && [[ "$current_code" == "$previous_failed_code" ]]; then
        repeat_failures=$((repeat_failures + 1))
    else
        repeat_failures=1
    fi
    previous_failed_code="$current_code"
    have_previous_failure=1
    (( repeat_failures < 3 )) || die "the model repeated the same failing Bash block three times"
}
for ((iteration=1; iteration<=maximum; iteration++)); do
    yield_to_pending
    messages="$run_dir/messages.json"
    "$context" > "$messages"
    response="$run_dir/response"
    usage="$run_dir/usage.json"
    printf 'milk-man: reasoning %d/%d with %s\n' "$iteration" "$maximum" "$LLM_MODEL" >&2
    if [[ "$native_tools" == 1 ]]; then
        "$llm" --system-file "$system_file" --messages-file "$messages" --tools-file "$run_dir/tools.json" --json-response --usage-file "$usage" > "$response"
    else
        "$llm" --system-file "$system_file" --messages-file "$messages" --usage-file "$usage" > "$response"
    fi
    yield_to_pending

    code="$run_dir/code"
    message="$run_dir/message.json"
    protocol_error="$run_dir/protocol-error"
    rm -f "$message" "$protocol_error"
    python3 - "$response" "$code" "$native_tools" "$message" "$protocol_error" <<'PY'
import json
import re
import shlex
import sys

text = open(sys.argv[1]).read()
if sys.argv[3] == "1":
    message = json.loads(text)["message"]
    calls = message.get("tool_calls", [])
    if len(calls) != 1:
        raise SystemExit("shellm: expected one function call")
    call = calls[0]
    if not isinstance(call, dict) or not isinstance(call.get("id"), str) or not call["id"]:
        raise SystemExit("shellm: function call requires a nonempty id")
    with open(sys.argv[4], "w") as handle:
        json.dump(message, handle, ensure_ascii=False, separators=(",", ":"))
    function = call.get("function")
    name = function.get("name") if isinstance(function, dict) else None
    raw_arguments = function.get("arguments") if isinstance(function, dict) else None
    error = None
    try:
        arguments = json.loads(raw_arguments) if isinstance(raw_arguments, str) else None
    except json.JSONDecodeError:
        arguments = None
    keys = ", ".join(sorted(arguments))[:256] if isinstance(arguments, dict) and arguments else "none"
    if not isinstance(arguments, dict):
        code, error = "", "function arguments must be a JSON object"
    elif name == "bash" and (set(arguments) != {"code"} or not isinstance(arguments.get("code"), str) or not arguments["code"].strip()):
        code, error = "", f"bash requires one nonempty string code argument; received keys: {keys}"
    elif name == "finish" and (set(arguments) != {"report"} or not isinstance(arguments.get("report"), str) or not arguments["report"].strip() or "\0" in arguments["report"]):
        code, error = "", f"finish requires one nonempty string report argument; received keys: {keys}"
    elif name == "bash":
        code = arguments["code"]
    elif name == "finish":
        code = "FINAL=" + shlex.quote(arguments["report"].strip())
    else:
        code, error = "", "unsupported function; expected bash or finish"
    if error:
        open(sys.argv[5], "w").write("milk-man protocol error: " + error + "\n")
        open(sys.argv[1], "w").write("Native function call was not executed.\n")
    else:
        # Keep human-readable Bash beside the native assistant message.
        open(sys.argv[1], "w").write("```bash\n" + code + "\n```\n")
else:
    match = re.search(r"(?ms)```(?:bash|sh|shell)[ \t]*\r?\n(.*?)(?:```|\Z)", text)
    code = match.group(1) if match else ""
open(sys.argv[2], "w").write(code)
PY
    if [[ "$native_tools" == 1 ]]; then
        append --type reasoning --content-file "$response" --message-file "$message" --usage-file "$usage"
    else
        append --type reasoning --content-file "$response" --usage-file "$usage"
    fi

    if [[ ! -s "$code" ]]; then
        output="$run_dir/output"
        if [[ -s "$protocol_error" ]]; then
            cp "$protocol_error" "$output"
        else
            printf '%s\n' 'milk-man protocol error: response must include a fenced Bash block' > "$output"
        fi
        cat "$output" >&2
        append --type shell-output --content-file "$output" --command-file "$code" --exit-code 65
        note_failure
        continue
    fi

    printf 'milk-man: executing Bash in %s\n' "$workdir" >&2
    redact < "$code" | sed 's/^/  /' >&2
    output="$run_dir/output"
    final="$run_dir/final"
    runner="$run_dir/run"
    rm -f "$final"
    {
        printf '%s\n' 'set -euo pipefail'
        printf '%s\n' '__milk_capture_final() {'
        printf '%s\n' '    __milk_rc=$?'
        printf '%s\n' '    trap - EXIT'
        printf '%s\n' '    set +e'
        printf '    if [[ ${FINAL+x} ]]; then printf %%s "$FINAL" > %q; fi\n' "$final"
        printf '    if [[ ${FINAL_FILE+x} ]]; then cat "$FINAL_FILE" > %q; fi\n' "$final"
        printf '%s\n' '    exit "$__milk_rc"'
        printf '%s\n' '}'
        printf '%s\n' 'trap __milk_capture_final EXIT'
        printf 'source %q\n' "$code"
        printf '%s\n' '__milk_rc=$?'
        printf '%s\n' 'trap - EXIT'
        printf 'if [[ ${FINAL+x} ]]; then printf %%s "$FINAL" > %q; fi\n' "$final"
        printf 'if [[ ${FINAL_FILE+x} ]]; then cat "$FINAL_FILE" > %q; fi\n' "$final"
        printf '%s\n' 'exit "$__milk_rc"'
    } > "$runner"

    set +e
    (cd "$workdir" && bash "$runner") 2>&1 | redact | tee "$output" >&2
    pipeline_status=("${PIPESTATUS[@]}")
    exit_code="${pipeline_status[0]}"
    set -e
    (( pipeline_status[1] == 0 )) || die "could not redact command output"
    (( pipeline_status[2] == 0 )) || die "could not capture command output"
    final_ok=0
    protocol_failed=0
    if [[ -f "$final" ]]; then
        final_content="$(<"$final")"
        final_content="${final_content#"${final_content%%[![:space:]]*}"}"
        final_content="${final_content%"${final_content##*[![:space:]]}"}"
        if (( exit_code == 0 )); then
            case "$final_content" in
                ""|0|1|true|false) ;;
                *) final_ok=1 ;;
            esac
        fi
        if (( ! final_ok )); then
            protocol_failed=1
            printf '\n%s\n' \
                'milk-man protocol error: FINAL or FINAL_FILE requires exit zero and nonblank text other than 0, 1, true, or false' \
                | tee -a "$output" >&2
        fi
    fi

    recorded_exit="$exit_code"
    (( ! protocol_failed || recorded_exit != 0 )) || recorded_exit=65
    append --type shell-output --content-file "$output" --command-file "$code" --exit-code "$recorded_exit"

    if (( recorded_exit == 0 && ! final_ok )) && [[ ! -f "$final" && -n "${MILK_MAN_HEARTBEAT_FILE:-}" ]] &&
        python3 - "$MILK_MAN_HEARTBEAT_FILE" "$final" <<'PY'
from pathlib import Path
import sys
from milk_v2.heartbeat import read
if not read(Path(sys.argv[1])).get("watch"):
    raise SystemExit(1)
Path(sys.argv[2]).write_text("Waiting for the registered heartbeat check. Milk Man will resume when it changes or becomes due.\n")
PY
    then
        final_ok=1
    fi

    if (( final_ok )); then
        append --type final --content-file "$final"
        redact < "$final"
        exit 0
    fi

    if (( recorded_exit != 0 )); then
        note_failure
    else
        repeat_failures=0
        have_previous_failure=0
    fi
done

printf '%s\n' 'shellm: iteration budget exhausted; continuing the saved task' >&2
exit 76
