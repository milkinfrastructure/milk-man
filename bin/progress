#!/usr/bin/env bash
set -euo pipefail

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
"$repo/bin/milk" status | python3 -c '
import json, sys
result = json.load(sys.stdin)
details = result["details"]
progress = {
    "captured": details["capture_count"],
    "summarized": details["processed_count"],
    "next": result["next"],
}
if sys.argv[1] == "run":
    progress = {**{key: result[key] for key in ("state", "identity", "next", "inference_calls", "provider_calls")}, "details": progress}
print(json.dumps(progress, sort_keys=True))
' "${1:-}"
