#!/usr/bin/env bash
set -euo pipefail
umask 077

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
STATE_PY="$ROOT/milk_v2/state.py"
HEADLONG_BIN="$ROOT/vendor/headlong/bin"

usage() {
    cat <<'EOF'
Usage:
  bin/man dashboard
  bin/man run --workspace NAME=/absolute/path [--resume] -- TASK
  bin/man heartbeat status|pause|resume|stop
  bin/man heartbeat wait [--seconds N] [-- READ_ONLY_COMMAND ...]
  bin/man develop --workspace NAME=/absolute/path [--workspace ...] -- TASK
  bin/man develop --resume --workspace NAME=/absolute/path [--workspace ...] -- TASK
  bin/man develop --traj UUID --workspace NAME=/absolute/path [--workspace ...] -- TASK
  bin/man develop --check --workspace NAME=/absolute/path [--workspace ...]
  bin/man bootstrap --workspace NAME=/absolute/path [--workspace ...] -- TASK
  bin/man bootstrap --resume --workspace NAME=/absolute/path [--workspace ...] -- TASK

Provider selection, in order:
  LLM_API_URL + LLM_MODEL [+ LLM_API_KEY]
  MILK_CONTROLLER_BASE_URL + MILK_CONTROLLER_MODEL [+ MILK_CONTROLLER_API_KEY]
  MILK_BOOTSTRAP_BASE_URL + MILK_BOOTSTRAP_MODEL [+ MILK_BOOTSTRAP_API_KEY]
  OPENAI_API_KEY [+ OPENAI_BASE_URL + OPENAI_MODEL + OPENAI_API_MODE]

Develop uses the provider order above. Bootstrap deterministically runs the
fixed controller jobs before its first model call. Controller creation is a
dry run unless MILK_MODAL_CONTROLLER_APPLY=1.
EOF
}

die() { printf 'milk-man: %s\n' "$*" >&2; exit "${2:-64}"; }

mode="${1:-}"
case "$mode" in
    -h|--help|help) usage; exit 0 ;;
    dashboard)
        exec env PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m milk_v2.dashboard
        ;;
    heartbeat)
        shift
        exec env PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m milk_v2.heartbeat "$@"
        ;;
    develop|bootstrap|run) shift ;;
    "") usage >&2; exit 64 ;;
    *) die "unknown command: $1" ;;
esac

workspaces=()
state_arguments=()
resume=0
trajectory=""
check=0
task_parts=()
while (( $# )); do
    case "$1" in
        --workspace)
            [[ -n "${2:-}" ]] || die "--workspace requires name=/absolute/path"
            workspaces+=("$2")
            state_arguments+=(--workspace "$2")
            shift 2
            ;;
        --resume) resume=1; shift ;;
        --traj)
            trajectory="${2:?--traj requires an exact UUID}"
            shift 2
            ;;
        --check) check=1; shift ;;
        --) shift; task_parts=("$@"); break ;;
        -*) die "unknown option: $1" ;;
        *) task_parts+=("$1"); shift ;;
    esac
done

(( ${#workspaces[@]} )) || die "at least one --workspace is required"
(( ! resume || ${#trajectory} == 0 )) || die "--resume and --traj are mutually exclusive"
if (( ! check && ${#task_parts[@]} == 0 )); then
    [[ "$mode" == run && "$resume" == 1 ]] || die "a task is required after --"
fi
if [[ "$mode" == bootstrap ]] && (( ${#trajectory} || check )); then
    die "bootstrap accepts a new or resumed trajectory; --traj and --check are invalid"
fi
[[ -r "$ROOT/goal_tracker.md" && -r "$ROOT/prompts/develop.md" && -x "$HEADLONG_BIN/shellm" ]] || {
    die "the Milk Man runtime is incomplete" 70
}

state_root="${MILK_MAN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/milk-man}"
[[ "$state_root" == /* && "$state_root" != / && "$state_root" != "$HOME" ]] || {
    die "MILK_MAN_STATE_DIR must be an absolute dedicated directory"
}
mkdir -p "$state_root"
chmod 700 "$state_root"
state_root="$(cd "$state_root" && pwd -P)"
[[ "$state_root" != / && "$state_root" != "$HOME" ]] || die "MILK_MAN_STATE_DIR resolves to an unsafe directory"

normalize_base_url() {
    local url="${1%/}"
    local mode="${2:-chat_completions}"
    case "$url" in
        */chat/completions|*/responses) printf '%s' "$url" ;;
        *)
            case "$mode" in
                chat_completions) printf '%s/chat/completions' "$url" ;;
                responses) printf '%s/responses' "$url" ;;
                *) die "API mode must be chat_completions or responses" ;;
            esac
            ;;
    esac
}

provider_source=""
if [[ "$mode" == bootstrap ]]; then
    provider_source="CONTROLLER_BOOTSTRAP"
else
    if [[ -n "${LLM_API_URL:-}" || -n "${LLM_MODEL:-}" ]]; then
        [[ -n "${LLM_API_URL:-}" && -n "${LLM_MODEL:-}" ]] || die "LLM_API_URL and LLM_MODEL must be set together"
        provider_source="LLM"
    elif [[ -n "${MILK_CONTROLLER_BASE_URL:-}" || -n "${MILK_CONTROLLER_MODEL:-}" ]]; then
        [[ -n "${MILK_CONTROLLER_BASE_URL:-}" && -n "${MILK_CONTROLLER_MODEL:-}" ]] || {
            die "MILK_CONTROLLER_BASE_URL and MILK_CONTROLLER_MODEL must be set together"
        }
        LLM_API_URL="$(normalize_base_url "$MILK_CONTROLLER_BASE_URL")"
        LLM_MODEL="$MILK_CONTROLLER_MODEL"
        LLM_API_KEY="${MILK_CONTROLLER_API_KEY:-}"
        provider_source="MILK_CONTROLLER"
    elif [[ -n "${MILK_BOOTSTRAP_BASE_URL:-}" || -n "${MILK_BOOTSTRAP_MODEL:-}" ]]; then
        [[ -n "${MILK_BOOTSTRAP_BASE_URL:-}" && -n "${MILK_BOOTSTRAP_MODEL:-}" ]] || {
            die "MILK_BOOTSTRAP_BASE_URL and MILK_BOOTSTRAP_MODEL must be set together"
        }
        LLM_API_URL="$(normalize_base_url "$MILK_BOOTSTRAP_BASE_URL")"
        LLM_MODEL="$MILK_BOOTSTRAP_MODEL"
        LLM_API_KEY="${MILK_BOOTSTRAP_API_KEY:-}"
        provider_source="MILK_BOOTSTRAP"
    elif [[ -n "${OPENAI_API_KEY:-}" ]]; then
        LLM_API_MODE="${OPENAI_API_MODE:-responses}"
        LLM_API_URL="$(normalize_base_url "${OPENAI_BASE_URL:-https://api.openai.com/v1}" "$LLM_API_MODE")"
        LLM_MODEL="${OPENAI_MODEL:-gpt-6-astra}"
        LLM_API_KEY="$OPENAI_API_KEY"
        LLM_REASONING_EFFORT="${LLM_REASONING_EFFORT:-low}"
        provider_source="OPENAI"
    else
        die "configure an OpenAI-compatible provider; see bin/man --help"
    fi
    LLM_MAX_TOKENS="${LLM_MAX_TOKENS:-32768}"
    export LLM_API_URL LLM_MODEL LLM_API_KEY LLM_API_MODE LLM_REASONING_EFFORT LLM_MAX_TOKENS
fi

environment_file="$(mktemp "$state_root/.man-env.XXXXXX")"
system_file="$(mktemp "$state_root/.system.XXXXXX")"
prompt_file="$(mktemp "$state_root/.prompt.XXXXXX")"
controller_file=""
controller_result=""
controller_status=""
job_command=""
job_stderr=""
cleanup() {
    rm -f "$environment_file" "$system_file" "$prompt_file"
    [[ -z "$controller_file" ]] || rm -f "$controller_file" "$controller_result" "$controller_status" "$job_command" "$job_stderr"
}
trap cleanup EXIT INT TERM

prepare=(python3 "$STATE_PY" prepare --state-root "$state_root" "${state_arguments[@]}" --env-file "$environment_file")
if (( resume )); then prepare+=(--resume); fi
if [[ -n "$trajectory" ]]; then prepare+=(--traj "$trajectory"); fi
"${prepare[@]}"
# shellcheck disable=SC1090 -- generated solely by milk_v2/state.py with shell quoting
source "$environment_file"

export MILK_MAN_STATE_PY="$STATE_PY"
export MILK_MAN_SKILLS_DIR="$ROOT/skills"
export MILK_MAN_TRAJECTORY MILK_MAN_TRAJECTORY_ID MILK_MAN_WORKSPACE_DIGEST
export MILK_MAN_WORKSPACE_RECORD MILK_MAN_MEMORY_FILE MILK_MAN_PRIMARY_WORKSPACE
export MILK_MAN_PROVIDER_SOURCE="$provider_source"
export MILK_MAN_CONTEXT_BYTES="${MILK_MAN_CONTEXT_BYTES:-32768}"
export MILK_MAN_MEMORY_BYTES="${MILK_MAN_MEMORY_BYTES:-4096}"
export PATH="$HEADLONG_BIN:$ROOT/bin:$PATH"
normal_path="$PATH"

write_system() {
    {
        cat "$1"
        printf '\n# Runtime context\n\n'
        printf 'The human task is authoritative. The tracker is `%s/goal_tracker.md`; use `rg` to read only a named relevant section when needed.\n' "$ROOT"
        printf 'Use `bin/milk jobs` to discover jobs and environment names. Start a job with `bin/milk run NAME`; append `status` or `stop` only when advertised. Credentials are already inherited; read source only after a command fails. Host: %s; Bash %s.\n' "$(uname -s)" "$BASH_VERSION"
        printf 'Driver settings are LLM_MODEL, LLM_API_URL, LLM_API_MODE, and LLM_REASONING_EFFORT. The object-store scope is MILK_SCOPE_ID. Read these exact environment names; never print credentials.\n'
        printf '\nBound workspaces and initial Git state:\n\n```json\n'
        python3 -m json.tool "$MILK_MAN_WORKSPACE_RECORD"
        printf '```\n\nAvailable skills:\n\n'
        skills list
        printf '\nDurable memory for this exact workspace set:\n\n'
        mem show
        if [[ "$mode" == run ]]; then
            printf '\n# Continuous task\n\n'
            printf 'You are inside the persistent Bash heartbeat. Continue actionable work yourself. To await a job, call `man heartbeat wait -- READ_ONLY_STATUS_COMMAND` (example: `bin/milk run inference-status`). For a scheduled continuation use `man heartbeat wait --seconds N`. Return immediately after registering a wait; the runtime yields automatically. Never sleep or perform the follow-up yourself. The heartbeat resumes this task once due or changed. Save resource IDs and useful decisions with `mem add`. Status checks must not mutate resources or call inference. When finished, call finish (or set FINAL in fenced mode) without registering another wait; remain idle for new instructions.\n'
        fi
    } > "$system_file"
}

run_headlong() {
    printf '%s\n' "$1" > "$prompt_file"
    "$HEADLONG_BIN/shellm" \
        --system-file "$system_file" \
        --prompt-file "$prompt_file" \
        --trajectory "$MILK_MAN_TRAJECTORY" \
        --workdir "$MILK_MAN_PRIMARY_WORKSPACE"
}

if (( check )); then
    python3 - <<'PY'
import json, os
print(json.dumps({
    "ok": True,
    "provider": os.environ["MILK_MAN_PROVIDER_SOURCE"],
    "model": os.environ["LLM_MODEL"],
    "trajectory_id": os.environ["MILK_MAN_TRAJECTORY_ID"],
    "workspace_digest": os.environ["MILK_MAN_WORKSPACE_DIGEST"],
}, sort_keys=True))
PY
    exit 0
fi

if [[ "$mode" == bootstrap ]]; then
    controller_file="$(mktemp "$state_root/.controller-env.XXXXXX")"
    controller_result="$(mktemp "$state_root/.controller-result.XXXXXX")"
    controller_status="$(mktemp "$state_root/.controller-status.XXXXXX")"
    job_command="$(mktemp "$state_root/.controller-command.XXXXXX")"
    job_stderr="$(mktemp "$state_root/.controller-stderr.XXXXXX")"

    controller_apply=0
    case "${MILK_MODAL_CONTROLLER_APPLY:-0}" in
        0|"") ;;
        1)
            controller_key_name="${MILK_MODAL_CONTROLLER_API_KEY_ENV:-MILK_CONTROLLER_API_KEY}"
            [[ "$controller_key_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid controller API-key environment name"
            [[ -n "${!controller_key_name-}" ]] || die "$controller_key_name is required when applying the controller"
            controller_apply=1
            ;;
        *) die "MILK_MODAL_CONTROLLER_APPLY must be 0 or 1" ;;
    esac
    export MILK_MODAL_CONTROLLER_APPLY="$controller_apply"

    run_controller_job() {
        local job="$1" output="$2" code
        printf 'milk run %s\n' "$job" > "$job_command"
        : > "$job_stderr"
        set +e
        "$ROOT/bin/milk" run "$job" > "$output" 2> "$job_stderr"
        code=$?
        set -e
        python3 "$STATE_PY" append \
            --trajectory "$MILK_MAN_TRAJECTORY" \
            --type shell-output \
            --content-file "$output" \
            --command-file "$job_command" \
            --exit-code "$code"
        [[ ! -s "$job_stderr" ]] || cat "$job_stderr" >&2
        return "$code"
    }

    printf '%s\n' "${task_parts[*]-}" > "$prompt_file"
    python3 "$STATE_PY" append \
        --trajectory "$MILK_MAN_TRAJECTORY" \
        --type prompt \
        --content-file "$prompt_file"
    if ! run_controller_job inference-status "$controller_status"; then
        die "inference-status failed; its result remains in the trajectory" 70
    fi
    controller_status_state="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["details"]["state"])' "$controller_status")"
    case "$controller_status_state" in
        ready_zero|ready_active) ;;
        *)
            if ! run_controller_job inference-ensure "$controller_result"; then
                die "inference-ensure failed; its result remains in the trajectory" 70
            fi
            ;;
    esac

    python3 - "$state_root" "$controller_status" "$controller_result" "${MILK_SCOPE_ID:-}" > "$controller_file" <<'PY'
import hashlib
import json
from pathlib import Path
import re
import shlex
import sys
from urllib.parse import urlsplit

state = Path(sys.argv[1])
expected_scope = sys.argv[4]

def job_result(path, job, command):
    try:
        outer = json.loads(Path(path).read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"milk-man: invalid {job} result: {error}")
    result = outer.get("details")
    if outer.get("schema_version") != "milk.job-result.v2" or outer.get("job") != job:
        raise SystemExit(f"milk-man: {job} envelope differs")
    if outer.get("scope_id") != expected_scope:
        raise SystemExit(f"milk-man: {job} scope differs")
    if not isinstance(result, dict) or result.get("schema_version") != "milk.modal-controller-result.v2":
        raise SystemExit(f"milk-man: {job} details differ")
    if result.get("command") != command or result.get("provider") != "modal":
        raise SystemExit(f"milk-man: {job} operation differs")
    if outer.get("identity") != result.get("controller_id") or outer.get("provider_calls") != result.get("provider_calls"):
        raise SystemExit(f"milk-man: {job} identity differs")
    return outer, result

status_outer, status_result = job_result(sys.argv[2], "inference-status", "status")
if Path(sys.argv[3]).stat().st_size:
    outer, result = job_result(sys.argv[3], "inference-ensure", "ensure")
else:
    outer, result = status_outer, status_result
if result.get("state") == "planned" and outer.get("state") == "idle":
    print("controller_state=planned")
    raise SystemExit(0)
expected_outer_state = {"ready": "complete", "ready_zero": "complete", "ready_active": "active"}.get(result.get("state"))
if expected_outer_state is None or outer.get("state") != expected_outer_state:
    raise SystemExit(f"milk-man: controller did not become ready: {result.get('state')}")

controller_id = result.get("controller_id")
run = state / "controller" / "runs" / str(controller_id)
try:
    binding = json.loads((state / "controller" / "current.json").read_text())
    intent = json.loads((run / "intent.json").read_text())
    endpoint = json.loads((run / "endpoint.json").read_text())
except (OSError, json.JSONDecodeError) as error:
    raise SystemExit(f"milk-man: incomplete controller binding: {error}")

def identity(value, field):
    received = value.get(field)
    body = dict(value)
    body.pop(field, None)
    raw = (json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode()
    if received != hashlib.sha256(raw).hexdigest():
        raise SystemExit(f"milk-man: invalid controller {field}")
    return received

if not isinstance(controller_id, str) or not re.fullmatch(r"[0-9a-f]{64}", controller_id):
    raise SystemExit("milk-man: invalid controller identity")
if intent.get("controller_id") != controller_id or intent.get("intent_id") != controller_id:
    raise SystemExit("milk-man: controller intent differs")
if endpoint.get("controller_id") != controller_id or binding.get("controller_id") != controller_id:
    raise SystemExit("milk-man: controller receipts differ")
if identity(endpoint, "endpoint_id") != binding.get("endpoint_id"):
    raise SystemExit("milk-man: controller endpoint differs")
identity(binding, "binding_id")
for field in ("app_id", "base_url", "model", "model_revision", "api_key_env"):
    if binding.get(field) != endpoint.get(field):
        raise SystemExit(f"milk-man: controller {field} differs")
if binding.get("schema_version") != "milk.modal-controller-binding.v2" or binding.get("provider") != "modal":
    raise SystemExit("milk-man: controller binding schema differs")
if binding.get("model") != "glm-4.5-air-fp8" or binding.get("model_revision") != "f9a9c5acf5e543cd24d659a056c5dbcda78ffcfc":
    raise SystemExit("milk-man: controller model differs")
if intent.get("model_revision") != binding["model_revision"] or intent.get("served_model") != binding["model"]:
    raise SystemExit("milk-man: controller intent model differs")
url = urlsplit(str(binding.get("base_url", "")))
if url.scheme != "https" or not url.hostname or not url.hostname.endswith((".modal.run", ".modal.direct")) or url.path.rstrip("/") != "/v1" or url.query or url.fragment or url.username:
    raise SystemExit("milk-man: invalid controller base URL")
api_key_env = binding.get("api_key_env")
if not isinstance(api_key_env, str) or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", api_key_env):
    raise SystemExit("milk-man: invalid controller API-key environment name")

for key, value in {
    "controller_state": "ready",
    "controller_base_url": binding["base_url"],
    "controller_model": binding["model"],
    "controller_api_key_env": api_key_env,
}.items():
    print(f"{key}={shlex.quote(value)}")
PY
    # shellcheck disable=SC1090 -- validated assignments emitted above
    source "$controller_file"
    if [[ "$controller_state" == planned ]]; then
        cat "$controller_result"
        exit 0
    fi

    controller_token="${!controller_api_key_env-}"
    [[ -n "$controller_token" ]] || die "$controller_api_key_env is required for the controller handoff"
    MILK_MAN_CONTROLLER_URL="$controller_base_url" MILK_MAN_CONTROLLER_TOKEN="$controller_token" \
    MILK_MAN_CONTROLLER_TIMEOUT="${MILK_MODAL_CONTROLLER_STARTUP_TIMEOUT:-1800}" \
    PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
import json, os, time
from milk_v2.providers.modal_controller import request_until_ready, SERVED_MODEL

body, error = request_until_ready(
    os.environ["MILK_MAN_CONTROLLER_URL"].rstrip("/") + "/models",
    os.environ["MILK_MAN_CONTROLLER_TOKEN"],
    None,
    time.monotonic() + int(os.environ["MILK_MAN_CONTROLLER_TIMEOUT"]),
)
if error or SERVED_MODEL not in {row.get("id") for row in json.loads(body).get("data", []) if isinstance(row, dict)}:
    raise SystemExit("milk-man: controller did not become ready for handoff")
PY
    unset "$controller_api_key_env"
    while read -r name; do
        case "$name" in MILK_BOOTSTRAP_*|MILK_MODAL_*|MODAL_*|OPENAI_*) unset "$name" ;; esac
    done < <(compgen -v)
    unset HF_TOKEN

    LLM_API_URL="$(normalize_base_url "$controller_base_url")"
    LLM_MODEL="$controller_model"
    LLM_API_KEY="$controller_token"
    LLM_REASONING_EFFORT="${MILK_CONTROLLER_REASONING_EFFORT:-high}"
    # The controller is served with a 32K context. Leave room for the goal,
    # skills, trajectory, and tool output instead of requesting Headlong's
    # generic 16K completion ceiling.
    LLM_MAX_TOKENS=4096
    provider_source="MILK_CONTROLLER"
    export LLM_API_URL LLM_MODEL LLM_API_KEY LLM_MAX_TOKENS LLM_REASONING_EFFORT
    export MILK_MAN_PROVIDER_SOURCE="$provider_source"
    export PATH="$normal_path"
    write_system "$ROOT/prompts/develop.md"
    run_headlong "The deterministic controller jobs above established the reviewed controller. Continue the original task from this trajectory."
    exit 0
fi

write_system "$ROOT/prompts/develop.md"
if [[ "$mode" == run ]]; then
    printf '%s\n' "${task_parts[*]-}" > "$prompt_file"
    export MILK_MAN_HEARTBEAT_FILE="$MILK_MAN_TRAJECTORY.heartbeat.json"
    export MILK_HEARTBEAT_SYSTEM_FILE="$system_file"
    export MILK_HEARTBEAT_PROMPT_FILE="$prompt_file"
    export MILK_HEARTBEAT_NEW_TASK=0
    [[ -z "${task_parts[*]-}" ]] || export MILK_HEARTBEAT_NEW_TASK=1
    run_log="$MILK_MAN_TRAJECTORY.run.log"
    : >> "$run_log"
    chmod 600 "$run_log"
    run_kind="resuming"
    (( MILK_HEARTBEAT_NEW_TASK == 0 )) || run_kind="starting"
    if [[ "${MILK_MAN_RUN_LOG_EXTERNAL:-0}" == 1 ]]; then
        unset MILK_MAN_RUN_LOG_EXTERNAL
        printf 'milk-man: %s trajectory %s\n' "$run_kind" "$MILK_MAN_TRAJECTORY_ID"
        "$ROOT/bin/heartbeat"
        exit $?
    fi
    set +e
    {
        printf 'milk-man: %s trajectory %s\n' "$run_kind" "$MILK_MAN_TRAJECTORY_ID"
        "$ROOT/bin/heartbeat"
    } 2>&1 | tee -a "$run_log"
    run_status=("${PIPESTATUS[@]}")
    set -e
    (( run_status[0] == 0 )) || exit "${run_status[0]}"
    (( run_status[1] == 0 )) || die "could not write the live run log" 74
    exit 0
fi
run_headlong "${task_parts[*]-}"
