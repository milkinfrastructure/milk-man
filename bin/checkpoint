#!/usr/bin/env python3
"""Read compact facts from one immutable summary and its verified ancestry."""

import json
import os
from pathlib import Path
import re
import sys
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from milk_v2 import eval_plan, summary
from milk_v2.state import redact
from milk_v2.store import StoreError, open_store, settings_from_environment


def counts(value, allowed, maximum):
    if not isinstance(value, dict):
        return None
    result = {}
    for label, count in value.items():
        if type(count) is not int or not 0 <= count <= maximum:
            raise ValueError("checkpoint label count is invalid")
        if allowed is not None and label not in allowed:
            raise ValueError("checkpoint label is outside the summary taxonomy")
        if allowed is None and not re.fullmatch(r"[a-z]{2,3}(?:-[A-Za-z]{2,4})?|mixed|unknown", label):
            label = "unknown"
        result[label] = result.get(label, 0) + count
    return result


def main():
    if sys.argv[1:] not in ([], ["run"]):
        raise ValueError("usage: checkpoint [run]")
    settings = settings_from_environment()
    key, expected = os.environ["MILK_CHECKPOINT_KEY"], os.environ["MILK_CHECKPOINT_SHA256"]
    readiness_key, readiness_sha = os.environ.get("MILK_READINESS_KEY"), os.environ.get("MILK_READINESS_SHA256")
    if bool(readiness_key) != bool(readiness_sha):
        raise ValueError("MILK_READINESS_KEY and MILK_READINESS_SHA256 must be set together")
    prefix = settings.scope_prefix + "s/"
    if not key.startswith(prefix) or not key.endswith("/summary.json"):
        raise ValueError("checkpoint key must identify a summary in the configured scope")
    identity = key[len(prefix):-len("/summary.json")]
    if str(uuid.UUID(identity)) != identity or not re.fullmatch(r"[0-9a-f]{64}", expected):
        raise ValueError("checkpoint UUID or SHA-256 is invalid")
    store = open_store(settings)
    body = store.get(key).body
    if summary.digest(body) != expected:
        raise ValueError("checkpoint digest differs")
    value = summary._json(body, "checkpoint")
    if not isinstance(value, dict) or any(value.get(name) != wanted for name, wanted in {
        "schema_version": "milk.summary.v2", "summary_uuid": identity,
        "scope_id": settings.scope_id, "profile": settings.profile,
    }.items()):
        raise ValueError("checkpoint identity differs")
    rows, unused_keys = summary._ancestry(store, settings, value)
    groups = {(row["source_group_kind"], row["source_group_sha256"]) for row in rows}
    semantic = value.get("semantic", {}).get("cumulative", {})
    classified = semantic.get("classified")
    if value.get("capture_count") != len(rows) or type(classified) is not int or not 0 <= classified <= len(rows):
        raise ValueError("checkpoint counts differ from its ancestry")
    facts = {
        "checkpoint_key": key, "checkpoint_sha256": expected, "summary_uuid": identity,
        "scope_id": settings.scope_id, "profile": settings.profile,
        "checkpoint_digest_verified": True, "exchanges": len(rows),
        "source_groups": len(groups),
        "trajectory_groups": sum(kind == "trajectory" for kind, unused in groups),
        "request_groups": sum(kind == "request" for kind, unused in groups),
        "classified": classified,
        "summary_statistics": {
            name: counts(semantic.get(field), allowed, classified)
            for name, field, allowed in (
                ("topics", "domain", summary.DOMAINS),
                ("tasks", "operation", summary.OPERATIONS),
                ("capabilities", "capability", summary.CAPABILITIES),
                ("languages", "language", None),
                ("sentiment", "sentiment", summary.SENTIMENTS),
                ("estimated_outcomes", "outcome", summary.OUTCOMES),
            )
        },
        "tool_bearing_exchanges": sum(row.get("tool_definitions", 0) > 0 or row.get("tool_calls", 0) > 0 for row in rows),
        "text_eval_eligible_exchanges": sum(eval_plan._eligible(row) for row in rows),
        "note": "Summary statistics describe the classified sample, not every exchange; capabilities may overlap. Outcomes are model estimates, not measured task success. Missing statistics are null; non-code language labels are grouped as unknown. HTTP completion does not establish task success. Text eligibility excludes split and held-out selection.",
    }
    if readiness_key:
        prefix = settings.scope_prefix + "readiness/"
        if not readiness_key.startswith(prefix) or not readiness_key.endswith(".json"):
            raise ValueError("readiness key is outside the configured scope")
        readiness_uuid = readiness_key[len(prefix):-len(".json")]
        if str(uuid.UUID(readiness_uuid)) != readiness_uuid or not re.fullmatch(r"[0-9a-f]{64}", readiness_sha):
            raise ValueError("readiness UUID or SHA-256 is invalid")
        body = store.get(readiness_key).body
        if summary.digest(body) != readiness_sha:
            raise ValueError("readiness digest differs")
        readiness = summary._json(body, "readiness")
        if not isinstance(readiness, dict) or any(readiness.get(name) != wanted for name, wanted in {
            "schema_version": "milk.readiness.v3", "readiness_uuid": readiness_uuid,
            "scope_id": settings.scope_id, "profile": settings.profile, "summary_sha256": expected,
        }.items()):
            raise ValueError("readiness does not belong to this checkpoint")
        checks = readiness.get("checks")
        if (any(type(readiness.get(name)) is not bool for name in ("ready", "statistically_qualified"))
            or not isinstance(checks, dict) or any(type(value) is not bool for value in checks.values())):
            raise ValueError("readiness decisions are invalid")
        facts.update(summary_sha256=expected, readiness_key=readiness_key, readiness_sha256=readiness_sha,
                     readiness_digest_verified=True, ready=readiness["ready"],
                     statistically_qualified=readiness["statistically_qualified"], task_success_known=False,
                     failed_readiness_checks=sorted(name for name, passed in checks.items() if not passed),
                     next_action="prepare_text_evals" if readiness["ready"] else "do_not_run_text_evals")
    identity = summary.digest({"summary": expected, "readiness": readiness_sha}) if readiness_key else expected
    print(json.dumps({"state": "complete", "identity": identity, "inference_calls": 0, "provider_calls": 0, "details": facts}, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except (KeyError, ValueError, OSError, StoreError) as error:
        print(json.dumps({"state": "failed", "identity": "checkpoint", "inference_calls": 0, "provider_calls": 0, "error": redact(str(error))}, separators=(",", ":")))
        raise SystemExit(1)
