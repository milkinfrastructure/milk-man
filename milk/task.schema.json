{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/milkinfrastructure/milk-creamery/blob/main/milk/task.schema.json",
  "title": "Milk local agent task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "repositories",
    "allowed_paths",
    "acceptance",
    "gates",
    "limits",
    "permissions",
    "config_digests",
    "credential_refs"
  ],
  "properties": {
    "schema_version": { "const": "milk.local-agent-task.v1" },
    "task": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "base_commit", "branch"],
        "properties": {
          "name": {
            "enum": ["milk-gateway", "milk-harness", "milk-creamery"]
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/milkinfrastructure/milk-(gateway|harness|creamery)(\\.git)?$"
          },
          "base_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "branch": {
            "type": "string",
            "pattern": "^codex/[a-z0-9][a-z0-9._/-]{0,127}$"
          }
        }
      }
    },
    "allowed_paths": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "propertyNames": {
        "enum": ["milk-gateway", "milk-harness", "milk-creamery"]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).{1,512}$"
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "milk-gateway:test",
          "milk-harness:test",
          "milk-creamery:check"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns",
        "max_tokens",
        "wall_time_seconds",
        "gate_time_seconds",
        "max_output_bytes",
        "model_spend_microusd"
      ],
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_tokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "gate_time_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760
        },
        "model_spend_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25000000
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_model_call",
        "push",
        "cloud_deploy",
        "milk_provider_call",
        "object_write",
        "route_prepare",
        "route_sign",
        "route_publish"
      ],
      "properties": {
        "agent_model_call": { "type": "boolean" },
        "push": { "type": "boolean" },
        "cloud_deploy": { "type": "boolean" },
        "milk_provider_call": { "type": "boolean" },
        "object_write": { "type": "boolean" },
        "route_prepare": { "type": "boolean" },
        "route_sign": { "type": "boolean" },
        "route_publish": { "type": "boolean" }
      }
    },
    "config_digests": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "credential_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name"],
        "properties": {
          "kind": { "const": "environment" },
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
        }
      }
    }
  }
}
