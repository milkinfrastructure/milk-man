{
  "schema_version": "milk.jobs.v2",
  "environment_bindings": {
    "store": {
      "required": ["MILK_SCOPE_ID", "MILK_STORE_KIND"],
      "optional": ["MILK_SCOPE_PROFILE", "MILK_STORE_ROOT", "MILK_STORE_ENDPOINT", "MILK_STORE_REGION", "MILK_STORE_BUCKET", "MILK_STORE_ACCESS_KEY_ID", "MILK_STORE_SECRET_ACCESS_KEY", "MILK_STORE_SESSION_TOKEN", "MILK_STORE_PATH_STYLE", "MILK_STORE_TIMEOUT_SECONDS"]
    },
    "controller": {
      "required": ["MILK_CONTROLLER_BASE_URL", "MILK_CONTROLLER_MODEL", "MILK_CONTROLLER_API_KEY"],
      "optional": []
    },
    "summary": {
      "required": ["MILK_SUMMARY_BASE_URL", "MILK_SUMMARY_MODEL", "MILK_SUMMARY_API_KEY"],
      "optional": ["MILK_SUMMARY_API_MODE", "MILK_REASONING_EFFORT", "MILK_SUMMARY_THRESHOLDS", "MILK_SUMMARY_REPRESENTATIVE_SAMPLE", "MILK_SUMMARY_TAIL_SAMPLE", "MILK_CLASSIFIER_TEXT_BYTES", "MILK_SUMMARY_MAX_OUTPUT_TOKENS", "MILK_SUMMARY_MAX_TURNS", "MILK_EVAL_MIN_CAPTURES", "MILK_EVAL_REPRESENTATIVE_CASES", "MILK_EVAL_TAIL_CASES", "MILK_EVAL_MIN_UNIQUE_SOURCES", "MILK_EVAL_MIN_PARSE_WILSON_BPS", "MILK_EVAL_MAX_ABSTAIN_WILSON_BPS"]
    },
    "eval": {
      "required": ["MILK_EVAL_BASE_URL", "MILK_EVAL_MODEL", "MILK_EVAL_API_KEY"],
      "optional": ["MILK_EVAL_API_MODE", "MILK_REASONING_EFFORT", "MILK_CASES_PER_CONVERSATION", "MILK_EVAL_SOURCE_CONVERSATIONS", "MILK_EVAL_SHARD_CASES", "MILK_EVAL_PRECOMPUTE_SHARD", "MILK_EVAL_MAX_OUTPUT_TOKENS", "MILK_EVAL_MAX_TURNS"]
    },
    "teacher": {
      "required": ["MILK_TEACHER_BASE_URL", "MILK_TEACHER_MODEL", "MILK_TEACHER_API_KEY"],
      "optional": ["MILK_TEACHER_API_MODE", "MILK_REASONING_EFFORT", "MILK_TEACHER_MAX_OUTPUT_TOKENS", "MILK_DATASET_TRAIN_EXAMPLES", "MILK_DATASET_TEXT_BYTES"]
    },
    "modal": {
      "required": ["MODAL_TOKEN_ID", "MODAL_TOKEN_SECRET"],
      "optional": ["MODAL_ENVIRONMENT", "MILK_CONTROLLER_API_KEY", "MILK_MODAL_CONTROLLER_APPLY", "MILK_MODAL_CONTROLLER_APP_PREFIX", "MILK_MODAL_CONTROLLER_VOLUME", "MILK_MODAL_ROUTING_REGION", "MILK_MODAL_CONTROLLER_API_KEY_ENV", "MILK_MODAL_CONTROLLER_STARTUP_TIMEOUT", "MILK_MODAL_STOP_TIMEOUT", "MILK_MODAL_CLI"]
    },
    "baseten": {
      "required": ["BASETEN_API_KEY", "BASETEN_TRAINING_PROJECT_ID", "MILK_TRAIN_IMAGE"],
      "optional": ["BASETEN_TEAM_NAME", "BASETEN_TRAINING_ACCELERATOR", "MILK_BASETEN_RUNTIME_SECRET_MAP_JSON", "MILK_DATASET_MANIFEST_KEY", "MILK_DATASET_MANIFEST_SHA256", "MILK_TRAIN_STEPS", "MILK_TRAIN_MAX_TOKENS", "MILK_TRAIN_LEARNING_RATE", "MILK_TRAIN_RECIPE", "MILK_TRAIN_ROLLOUTS", "MILK_TRAIN_ROLLOUT_MAX_NEW_TOKENS", "MILK_EVAL_IMAGE", "MILK_EVALUATE_MAX_NEW_TOKENS"]
    },
    "candidate-baseten": {
      "required": ["BASETEN_API_KEY", "MILK_SERVE_IMAGE", "MILK_CANDIDATE_API_KEY"],
      "optional": ["BASETEN_TEAM_NAME", "MILK_CANDIDATE_ACCELERATOR", "MILK_ROUTE_CANDIDATE_BPS", "MILK_ROUTE_TIMEOUT_SECONDS"]
    },
    "candidate-modal": {
      "required": ["BASETEN_API_KEY", "MODAL_TOKEN_ID", "MODAL_TOKEN_SECRET", "MILK_SERVE_IMAGE", "MILK_CANDIDATE_API_KEY"],
      "optional": ["MODAL_ENVIRONMENT", "MILK_CANDIDATE_ACCELERATOR", "MILK_MODAL_CANDIDATE_APP_PREFIX", "MILK_MODAL_CANDIDATE_VOLUME_PREFIX", "MILK_MODAL_ROUTING_REGION", "MILK_MODAL_CLI", "MILK_ROUTE_CANDIDATE_BPS", "MILK_ROUTE_TIMEOUT_SECONDS"]
    },
    "route": {
      "required": [],
      "optional": ["MILK_ROUTE_VERIFY_KEY"]
    }
  },
  "operate_order": ["summary", "eval", "dataset", "train", "evaluate"],
  "jobs": {
    "training-baseten": {
      "description": "Read or stop an existing Baseten training job selected by MILK_TRAIN_PROVIDER_JOB_ID and BASETEN_TRAINING_PROJECT_ID. Run/status only reads; stop skips terminal jobs and checks provider state after requesting a stop. Never creates a job. A terminal provider status is not proof that model results have been collected; run the original train job to collect them.",
      "executable": "milk_v2/providers/baseten_training.py",
      "environment": {
        "required": ["BASETEN_API_KEY", "BASETEN_TRAINING_PROJECT_ID", "MILK_TRAIN_PROVIDER_JOB_ID"],
        "optional": ["MILK_TRAIN_TIMEOUT_SECONDS"]
      },
      "status": true,
      "stop": true,
      "timeout_env": "MILK_TRAIN_TIMEOUT_SECONDS"
    },
    "native-dataset": {
      "description": "Build native tool data from MILK_CHECKPOINT_KEY/SHA256 or MILK_NATIVE_CAPTURES_KEY/SHA256, never both. MILK_NATIVE_DATASET_PER_GROUP defaults to one earliest exchange per trajectory. Optional MILK_NATIVE_TASK_OUTCOMES_KEY/SHA256 selects successful TRAIN tasks; held-out splits stay unchanged. Saves immutable splits and a manifest, not current pointers. Replay reads no captures. No inference/provider calls. Extraction alone proves no improvement.",
      "executable": "milk_v2/native_dataset.py",
      "environment": {
        "required": ["MILK_SCOPE_ID", "MILK_STORE_KIND"],
        "optional": ["MILK_CHECKPOINT_KEY", "MILK_CHECKPOINT_SHA256", "MILK_NATIVE_CAPTURES_KEY", "MILK_NATIVE_CAPTURES_SHA256", "MILK_NATIVE_DATASET_PER_GROUP", "MILK_NATIVE_TASK_OUTCOMES_KEY", "MILK_NATIVE_TASK_OUTCOMES_SHA256", "MILK_SCOPE_PROFILE", "MILK_STORE_ROOT", "MILK_STORE_ENDPOINT", "MILK_STORE_REGION", "MILK_STORE_BUCKET", "MILK_STORE_ACCESS_KEY_ID", "MILK_STORE_SECRET_ACCESS_KEY", "MILK_STORE_SESSION_TOKEN", "MILK_STORE_PATH_STYLE", "MILK_STORE_TIMEOUT_SECONDS"]
      },
      "status": false,
      "stop": false,
      "timeout_env": "MILK_STORE_TIMEOUT_SECONDS"
    },
    "native-trial": {
      "description": "Request one next action from pinned captured context and tools, withholding the saved answer. Never executes commands. Retains the source group/split and private receipts; completed replay makes no model call. Compare input_sha256 between trials: it hashes prepared messages/tools, not the saved artifact. A formatted answer is not proof of task success.",
      "executable": "bin/native-trial",
      "environment": {
        "required": ["MILK_NATIVE_TRIAL_FILE", "MILK_NATIVE_TRIAL_SHA256", "LLM_API_URL", "LLM_MODEL"],
        "optional": ["LLM_API_KEY", "LLM_API_MODE", "LLM_REASONING_EFFORT", "LLM_TOOL_CHOICE", "LLM_MAX_TOKENS", "LLM_CONNECT_TIMEOUT", "LLM_MAX_TIME", "MILK_SCOPE_ID", "MILK_MAN_STATE_DIR", "MILK_NATIVE_TRIAL_ID", "MILK_NATIVE_TRIAL_ATTEMPT", "MILK_NATIVE_TRIAL_JOB_TIMEOUT_SECONDS"]
      },
      "status": true,
      "stop": false,
      "timeout_env": "MILK_NATIVE_TRIAL_JOB_TIMEOUT_SECONDS"
    },
    "native-capture": {
      "description": "Extract visible assistant messages/tool targets from one pinned completed native capture. Requires exact MILK_NATIVE_CAPTURE_KEY and MILK_NATIVE_CAPTURE_SHA256. Preserves historical tool IDs/results and source grouping. Reasoning, including ciphertext, is omitted explicitly. Unsupported protocols/history are reported, never flattened. Raw content stays in a private local artifact; stdout contains counts and digests only. This does not prove task success or admit training data.",
      "executable": "milk_v2/native_capture.py",
      "environment": {
        "required": ["MILK_NATIVE_CAPTURE_KEY", "MILK_NATIVE_CAPTURE_SHA256", "MILK_SCOPE_ID", "MILK_STORE_KIND"],
        "optional": ["MILK_MAN_STATE_DIR", "MILK_SCOPE_PROFILE", "MILK_STORE_ROOT", "MILK_STORE_ENDPOINT", "MILK_STORE_REGION", "MILK_STORE_BUCKET", "MILK_STORE_ACCESS_KEY_ID", "MILK_STORE_SECRET_ACCESS_KEY", "MILK_STORE_SESSION_TOKEN", "MILK_STORE_PATH_STYLE", "MILK_STORE_TIMEOUT_SECONDS"]
      },
      "status": false,
      "stop": false,
      "timeout_env": "MILK_STORE_TIMEOUT_SECONDS"
    },
    "checkpoint": {
      "description": "Read a pinned summary and its verified ancestry. Set MILK_CHECKPOINT_KEY/SHA256. Optionally set MILK_READINESS_KEY/SHA256 together to read the matching saved admission decision and failed checks in the same result. Counts describe exchanges, independent source groups, the classified sample and text-eval eligibility. No capture bodies, current pointers, writes, inference or provider operations. Saved readiness is historical metadata, not a new admission decision; estimated outcomes do not prove task success.",
      "executable": "bin/checkpoint",
      "environment": {
        "required": ["MILK_CHECKPOINT_KEY", "MILK_CHECKPOINT_SHA256", "MILK_SCOPE_ID", "MILK_STORE_KIND"],
        "optional": ["MILK_READINESS_KEY", "MILK_READINESS_SHA256", "MILK_SCOPE_PROFILE", "MILK_STORE_ROOT", "MILK_STORE_ENDPOINT", "MILK_STORE_REGION", "MILK_STORE_BUCKET", "MILK_STORE_ACCESS_KEY_ID", "MILK_STORE_SECRET_ACCESS_KEY", "MILK_STORE_SESSION_TOKEN", "MILK_STORE_PATH_STYLE", "MILK_STORE_TIMEOUT_SECONDS"]
      },
      "status": false,
      "stop": false,
      "timeout_env": "MILK_STORE_TIMEOUT_SECONDS"
    },
    "agent-score": {
      "description": "Score one saved trial using its repository-owned task checker, without rerunning the model. Pin MILK_TRIAL_RESULT_FILE/SHA256. Keeps the original receipt unchanged and saves a separate scored result with source and checker digests. Repeating the same inputs replays without executing the checker. Checkers must verify actual task artifacts and pin their expected inputs; process exit and a model's report alone do not prove task success.",
      "executable": "bin/agent-score",
      "environment": {
        "required": ["MILK_TRIAL_RESULT_FILE", "MILK_TRIAL_RESULT_SHA256", "MILK_TRIAL_CHECK_SCRIPT", "MILK_TRIAL_WORKSPACE"],
        "optional": ["MILK_MAN_STATE_DIR", "MILK_TRIAL_CHECK_TIMEOUT_SECONDS"]
      },
      "status": false,
      "stop": false,
      "timeout_env": "MILK_TRIAL_JOB_TIMEOUT_SECONDS"
    },
    "agent-trial": {
      "description": "Run one Milk Man child on a task file and workspace using LLM_* settings. Returns a compact receipt with elapsed time, tool counts, final report and private evidence references; consume this receipt instead of dumping trajectories. Process completion is not a task-quality verdict. The same trial replays its saved result without model calls; use a new MILK_TRIAL_ATTEMPT only for an intentional new attempt. Status or replay by MILK_TRIAL_ID reads that exact saved trial.",
      "executable": "bin/agent-trial",
      "environment": {
        "required": ["MILK_TRIAL_TASK_FILE", "MILK_TRIAL_WORKSPACE", "LLM_API_URL", "LLM_MODEL"],
        "optional": ["LLM_API_KEY", "LLM_API_MODE", "LLM_REASONING_EFFORT", "LLM_TOOL_CHOICE", "LLM_MAX_TOKENS", "LLM_MILK_TRAJECTORY_HEADER", "MILK_MAN_MAX_ITERATIONS", "MILK_MAN_TOOL_CALLS", "MILK_MAN_CONTEXT_BYTES", "MILK_MAN_MEMORY_BYTES", "MILK_MAN_STATE_DIR", "MILK_TRIAL_ATTEMPT", "MILK_TRIAL_ID", "MILK_TRIAL_TIMEOUT_SECONDS", "MILK_TRIAL_JOB_TIMEOUT_SECONDS", "MILK_TRIAL_CHECK_SCRIPT", "MILK_TRIAL_CHECK_TIMEOUT_SECONDS"]
      },
      "status": true,
      "stop": false,
      "timeout_env": "MILK_TRIAL_JOB_TIMEOUT_SECONDS"
    },
    "serve-baseten": {
      "description": "Deploy, inspect, or stop vLLM on Baseten. Use a pinned HF base or MILK_BASETEN_SERVE_CHECKPOINT_KEY/SHA256 for a completed model manifest; MODEL/REVISION must match. Weights stay outside the image. Run returns during startup. Watch status; repeat run only to apply configuration, reusing the deployment. Complete means readiness, not inference. details.driver gives the endpoint and key environment name. For recent private logs, set MILK_BASETEN_SERVE_LOG_SECONDS=300 with status.",
      "executable": "milk_v2/providers/baseten_serve.py",
      "environment": {
        "required": ["BASETEN_API_KEY", "MILK_BASETEN_SERVE_MODEL", "MILK_BASETEN_SERVE_REVISION", "MILK_BASETEN_SERVE_IMAGE"],
        "optional": ["MILK_BASETEN_SERVE_LOG_SECONDS", "BASETEN_TEAM_NAME", "MILK_MAN_STATE_DIR", "MILK_BASETEN_SERVE_GPU", "MILK_BASETEN_SERVE_GPU_COUNT", "MILK_BASETEN_SERVE_SERVED_MODEL", "MILK_BASETEN_SERVE_VLLM_ARGS_JSON", "MILK_BASETEN_SERVE_HF_SECRET_NAME", "MILK_BASETEN_SERVE_CONCURRENCY", "MILK_BASETEN_SERVE_MIN_REPLICAS", "MILK_BASETEN_SERVE_MAX_REPLICAS", "MILK_BASETEN_SERVE_SCALEDOWN_SECONDS", "MILK_BASETEN_SERVE_PUSH_TIMEOUT_SECONDS", "MILK_BASETEN_SERVE_API_TIMEOUT_SECONDS", "MILK_BASETEN_SERVE_TIMEOUT_SECONDS", "MILK_BASETEN_SERVE_CHECKPOINT_KEY", "MILK_BASETEN_SERVE_CHECKPOINT_SHA256", "MILK_SCOPE_ID", "MILK_SCOPE_PROFILE", "MILK_STORE_KIND", "MILK_STORE_ROOT", "MILK_STORE_ENDPOINT", "MILK_STORE_REGION", "MILK_STORE_BUCKET", "MILK_STORE_ACCESS_KEY_ID", "MILK_STORE_SECRET_ACCESS_KEY", "MILK_STORE_SESSION_TOKEN", "MILK_STORE_PATH_STYLE", "MILK_STORE_TIMEOUT_SECONDS"]
      },
      "status": true,
      "stop": true,
      "timeout_env": "MILK_BASETEN_SERVE_TIMEOUT_SECONDS"
    },
    "progress": {
      "description": "Read the current scope's captured count, summarized count, and next job. This job does not write objects or call a model or provider.",
      "executable": "bin/progress",
      "environment": {
        "required": ["MILK_SCOPE_ID", "MILK_STORE_KIND"],
        "optional": ["MILK_SCOPE_PROFILE", "MILK_STORE_ROOT", "MILK_STORE_ENDPOINT", "MILK_STORE_REGION", "MILK_STORE_BUCKET", "MILK_STORE_ACCESS_KEY_ID", "MILK_STORE_SECRET_ACCESS_KEY", "MILK_STORE_SESSION_TOKEN", "MILK_STORE_PATH_STYLE", "MILK_STORE_TIMEOUT_SECONDS"]
      },
      "status": false,
      "stop": false,
      "timeout_env": "MILK_STORE_TIMEOUT_SECONDS"
    },
    "research": {
      "description": "Save MILK_RESEARCH_FILE: parent_revision, objective, targets, baseline, evaluation, best, experiments, next_action, wake. Keep current fields; parent_revision is status details.revision or null initially. Success returns progressed; replay/status returns idle. Each experiment must fit 8 KiB. Baseline/evaluation/best and experiments accept object_refs: name -> {key,sha256}. New saves check these scoped objects; replay/status do not reread them. Bind results AND configs. Hashes do not prove wins.",
      "executable": "milk_v2/research.py",
      "environment": {
        "required": ["MILK_SCOPE_ID", "MILK_STORE_KIND", "MILK_RESEARCH_FILE"],
        "optional": ["MILK_SCOPE_PROFILE", "MILK_STORE_ROOT", "MILK_STORE_ENDPOINT", "MILK_STORE_REGION", "MILK_STORE_BUCKET", "MILK_STORE_ACCESS_KEY_ID", "MILK_STORE_SECRET_ACCESS_KEY", "MILK_STORE_SESSION_TOKEN", "MILK_STORE_PATH_STYLE", "MILK_STORE_TIMEOUT_SECONDS", "MILK_RESEARCH_JOB_TIMEOUT_SECONDS", "MILK_SUMMARY_THRESHOLDS"]
      },
      "status": true,
      "stop": false,
      "timeout_env": "MILK_RESEARCH_JOB_TIMEOUT_SECONDS"
    },
    "inference-ensure": {"handler": "inference-ensure", "trigger": {"kind": "manual"}, "bindings": ["store", "modal"], "input_prefixes": ["j"], "output_prefixes": ["j", "status"], "system_prompt": null, "timeout_env": "MILK_CONTROLLER_TIMEOUT_SECONDS", "teardown_handler": "inference-stop"},
    "inference-status": {"handler": "inference-status", "trigger": {"kind": "manual"}, "bindings": ["store", "modal"], "input_prefixes": ["j"], "output_prefixes": ["j", "status"], "system_prompt": null, "timeout_env": "MILK_CONTROLLER_TIMEOUT_SECONDS", "teardown_handler": null},
    "inference-stop": {"handler": "inference-stop", "trigger": {"kind": "manual"}, "bindings": ["store", "modal"], "input_prefixes": ["j"], "output_prefixes": ["j", "status"], "system_prompt": null, "timeout_env": "MILK_CONTROLLER_TIMEOUT_SECONDS", "teardown_handler": null},
    "benchmark-compare": {
      "description": "Compare two saved benchmark receipts using exact file digests. No inference or provider calls. Reports matching request settings, correctness, timings and observed percentage changes; never declares a quality winner. Keep serving profile receipts separately. Use the original serving job's stop command for cleanup.",
      "executable": "bin/benchmark-compare",
      "environment": {
        "required": ["MILK_COMPARE_BASELINE_FILE", "MILK_COMPARE_BASELINE_SHA256", "MILK_COMPARE_CANDIDATE_FILE", "MILK_COMPARE_CANDIDATE_SHA256"],
        "optional": []
      },
      "status": false,
      "stop": false
    },
    "benchmark": {
      "description": "Measure configured chat inference: three requests and one in flight by default. MILK_BENCHMARK_CONCURRENCY selects simultaneous requests, up to the request count. Reports per-request latency and whole-run throughput separately, optional streaming time to first visible text, and exact expected-answer checks without raw answers. Keep request count, concurrency and workload unchanged when comparing serving settings. Set output-token allowance for reasoning models.",
      "executable": "bin/benchmark",
      "environment": {
        "required": ["MILK_BENCHMARK_BASE_URL", "MILK_BENCHMARK_MODEL", "MILK_BENCHMARK_API_KEY"],
        "optional": ["MILK_BENCHMARK_REQUESTS", "MILK_BENCHMARK_CONCURRENCY", "MILK_BENCHMARK_MAX_TOKENS", "MILK_BENCHMARK_TIMEOUT_SECONDS", "MILK_BENCHMARK_PROMPT", "MILK_BENCHMARK_EXPECTED", "MILK_BENCHMARK_INPUT_FILE", "MILK_BENCHMARK_STREAM", "MILK_BENCHMARK_COMPUTE_USD_PER_HOUR", "MILK_BENCHMARK_JOB_TIMEOUT_SECONDS"]
      },
      "status": false,
      "stop": false,
      "timeout_env": "MILK_BENCHMARK_JOB_TIMEOUT_SECONDS"
    },
    "serve-modal": {
      "description": "Deploy, inspect, or stop vLLM on Modal. details.driver returns URL, mode, model and serving-key env name; never forward the parent's gateway key. MILK_MODAL_SERVE_MIN_CONTAINERS=1 keeps one warm after hydration and is billable until stop; default 0 scales to zero. Arrange cleanup. details.observation.startup retains phase times, not billed duration. Status is read-only; optional MILK_MODAL_SERVE_LOG_LINES=20 reads private logs (default 0, max 100). Listed env names are required for run.",
      "executable": "milk_v2/providers/modal_serve.py",
      "environment": {
        "required": ["MODAL_TOKEN_ID", "MODAL_TOKEN_SECRET", "MILK_MODAL_SERVE_MODEL", "MILK_MODAL_SERVE_REVISION", "MILK_MODAL_SERVE_IMAGE", "MILK_MODAL_SERVE_API_KEY"],
        "optional": ["MODAL_ENVIRONMENT", "HF_TOKEN", "MILK_MAN_STATE_DIR", "MILK_MODAL_CLI", "MILK_MODAL_ROUTING_REGION", "MILK_MODAL_SERVE_APP_PREFIX", "MILK_MODAL_SERVE_VOLUME", "MILK_MODAL_SERVE_SERVED_MODEL", "MILK_MODAL_SERVE_GPU", "MILK_MODAL_SERVE_GPU_COUNT", "MILK_MODAL_SERVE_VLLM_ARGS_JSON", "MILK_MODAL_SERVE_SCALEDOWN_SECONDS", "MILK_MODAL_SERVE_MIN_CONTAINERS", "MILK_MODAL_SERVE_TARGET_CONCURRENCY", "MILK_MODAL_SERVE_STARTUP_TIMEOUT", "MILK_MODAL_SERVE_STOP_TIMEOUT", "MILK_MODAL_SERVE_TIMEOUT_SECONDS", "MILK_MODAL_SERVE_LOG_LINES"]
      },
      "status": true,
      "stop": true,
      "timeout_env": "MILK_MODAL_SERVE_TIMEOUT_SECONDS"
    },
    "summary": {"handler": "summary", "trigger": {"kind": "crossed_capture_threshold", "values_env": "MILK_SUMMARY_THRESHOLDS"}, "bindings": ["store", "summary"], "input_prefixes": ["c", "s"], "output_prefixes": ["j", "l", "s", "readiness", "status"], "system_prompt": "prompts/summary.md", "timeout_env": "MILK_SUMMARY_TIMEOUT_SECONDS", "teardown_handler": null},
    "eval": {"handler": "eval", "trigger": {"kind": "readiness"}, "bindings": ["store", "eval"], "input_prefixes": ["c", "l", "s", "readiness"], "output_prefixes": ["j", "e", "status"], "system_prompt": "prompts/eval.md", "timeout_env": "MILK_EVAL_TIMEOUT_SECONDS", "teardown_handler": null},
    "dataset": {"handler": "dataset", "trigger": {"kind": "eval_ready"}, "bindings": ["store", "teacher"], "input_prefixes": ["c", "e"], "output_prefixes": ["j", "d", "status"], "system_prompt": "prompts/dataset.md", "timeout_env": "MILK_DATASET_TIMEOUT_SECONDS", "teardown_handler": null},
    "train": {"description": "Train Qwen3.5-0.8B. Native SFT uses MILK_DATASET_MANIFEST_KEY/SHA256. Set MILK_TRAIN_STEPS at least TRAIN row count for a full pass; fewer steps omit later rows. History must fit MILK_TRAIN_MAX_TOKENS; no truncation. Repeat unchanged to collect/reuse. MILK_TRAIN_TIMEOUT_SECONDS is HTTP-only (1..120). Use training-baseten status/stop with the exact MILK_TRAIN_PROVIDER_JOB_ID. Without a manifest pair, use the text dataset.", "handler": "train", "trigger": {"kind": "dataset_ready"}, "bindings": ["store", "baseten"], "input_prefixes": ["d"], "output_prefixes": ["j", "t", "m", "status"], "system_prompt": null, "timeout_env": "MILK_TRAIN_TIMEOUT_SECONDS", "teardown_handler": null},
    "evaluate": {"handler": "evaluate", "trigger": {"kind": "training_ready"}, "bindings": ["store", "baseten"], "input_prefixes": ["d", "m"], "output_prefixes": ["j", "v", "status"], "system_prompt": null, "timeout_env": "MILK_EVALUATE_TIMEOUT_SECONDS", "teardown_handler": null},
    "route-propose-baseten": {"handler": "route-propose-baseten", "trigger": {"kind": "evaluation_ready"}, "bindings": ["store", "candidate-baseten"], "input_prefixes": ["m", "v"], "output_prefixes": ["j", "m", "p", "status"], "system_prompt": null, "timeout_env": "MILK_ROUTE_TIMEOUT_SECONDS", "teardown_handler": null},
    "route-propose-modal": {"handler": "route-propose-modal", "trigger": {"kind": "evaluation_ready"}, "bindings": ["store", "candidate-modal"], "input_prefixes": ["m", "v"], "output_prefixes": ["j", "m", "p", "status"], "system_prompt": null, "timeout_env": "MILK_ROUTE_TIMEOUT_SECONDS", "teardown_handler": "gpu-reconcile-modal"},
    "gpu-reconcile-modal": {"handler": "gpu-reconcile-modal", "trigger": {"kind": "provider_frontier"}, "bindings": ["store", "modal"], "input_prefixes": ["j", "m"], "output_prefixes": ["j", "status"], "system_prompt": null, "timeout_env": "MILK_GPU_TIMEOUT_SECONDS", "teardown_handler": null}
  }
}
